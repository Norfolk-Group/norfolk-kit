    "docs/design-system.md": "client-safe",
    "docs/README.md": "client-safe",
    "docs/architecture.md": "client-safe",
    "docs/api.md": "client-safe",
    "docs/business-logic.md": "client-safe",
    "docs/security.md": "client-safe",
    "docs/config-and-env-map.md": "client-safe",
    "docs/decisions/**": "norfolk-only",

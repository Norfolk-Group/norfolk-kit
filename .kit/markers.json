    ".cursor/**": "client-safe",
    ".devcontainer/**": "client-safe",
    ".github/**": "client-safe",
    ".kit/**": "client-safe",
    "tools/**": "client-safe",
    "src/components/animations/**": "client-safe",
    "docs/SYSTEM-GOVERNANCE-RULE.md": "client-safe",

# Key NAMES only. Real values live in Doppler (dev + prd configs) and are injected
# at runtime by `doppler run --`. Never fill this file in; never commit a real .env.
# This file exists so you can see the full expected surface at a glance.

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=
ENVIRONMENT=                    # dev | stg | prd

# ── Session & crypto ─────────────────────────────────────────────────────────
SESSION_SECRET=                 # long random string, distinct per environment
ENCRYPTION_KEY=                 # long random string, distinct per environment

# ── Database — Neon Postgres ─────────────────────────────────────────────────
DATABASE_URL=                   # postgresql://…neon.tech/…?sslmode=require

# ── Auth — WorkOS AuthKit ────────────────────────────────────────────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=         # >=32 chars, used to seal the session cookie
WORKOS_REDIRECT_URI=            # must match the callback registered in WorkOS

# ── Object storage — Cloudflare R2 (S3-compatible) ───────────────────────────
R2_ENDPOINT=                    # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# NOTE: the S3 client MUST set forcePathStyle: true and region: "auto" for R2.
# Without forcePathStyle, presigned URLs use virtual-hosted style and R2 returns 403.

# ── Video — Cloudflare Stream (only if the project handles video) ─────────────
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=

# ── Email — Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=

# ── Errors — Sentry ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ── LLM (in-app assistant via Vercel AI SDK) ─────────────────────────────────
ANTHROPIC_API_KEY=

# ── Alt-model launchers (tools/launchers) — dev tooling only ──────────────────
MOONSHOT_API_KEY=               # claude-kimi
ZAI_API_KEY=                    # claude-glm   (legacy alias: ZHIPU_API_KEY)
DASHSCOPE_API_KEY=              # claude-qwen
DEEPSEEK_API_KEY=               # claude-deepseek
OPENROUTER_API_KEY=             # claude-grok, claude-openai

# ── E-signature (only if the project needs countersigned documents) ──────────
DROPBOX_SIGN_API_KEY=

{
  "name": "@norfolk-ai/kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "node dist/server/server/index.js",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:production": "vitest run --config vitest.production.config.ts",
    "test:browser": "playwright test",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "docs:artifacts": "tsx tools/artifacts/build.ts",
    "docs:artifacts:check": "tsx tools/artifacts/build.ts --check",
    "docs:catalogs": "tsx tools/artifacts/catalogs-cli.ts",
    "docs:catalogs:check": "tsx tools/artifacts/catalogs-cli.ts --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:production && pnpm build:storybook && pnpm docs:artifacts:check && pnpm docs:catalogs:check && pnpm test:browser"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tailwindcss/vite": "4.3.3",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "framer-motion": "12.42.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/react-vite": "10.5.6",
    "@types/express": "5.0.6",
    "@types/node": "24.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "fast-glob": "3.3.3",
    "globals": "17.9.0",
    "storybook": "10.5.6",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  }
}
